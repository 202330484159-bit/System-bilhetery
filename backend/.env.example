# Local development example. Codespaces should use the complete Supabase JDBC URL stored as DB_URL secret.
DB_URL="jdbc:postgresql://localhost:5432/cinetickets?user=cinetickets&password=cinetickets_dev"
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Generate a random secret; never commit the real value.
# openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
