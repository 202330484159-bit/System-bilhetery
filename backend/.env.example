DB_URL=jdbc:postgresql://localhost:5432/cinetickets
DB_USERNAME=cinetickets
DB_PASSWORD=troque_esta_senha_local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Gere uma chave aleatória forte (mínimo 32 bytes) e nunca a versione:
# openssl rand -base64 48
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE
JWT_EXPIRATION_MINUTES=60
# Primeiro administrador criado automaticamente se ainda não existir:
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_COM_12_OU_MAIS_CARACTERES